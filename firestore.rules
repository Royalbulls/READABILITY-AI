rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection: Client can only read their own profile.
    // All writes must be performed securely server-side via firebase-admin.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // History collection: Client has full control over their own history logs.
    match /history/{docId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Projects collection: Client has full control over their own saved projects.
    match /projects/{docId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Transactions collection: Client can only read their own ledger records.
    // All transactional writes must be performed server-side via firebase-admin.
    match /transactions/{docId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Admins collection: Client can only read their own admin status.
    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
